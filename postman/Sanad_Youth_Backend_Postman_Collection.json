            "body": {
              "mode": "raw",
              "raw": "{\n  \"startsAt\": \"2027-01-15T10:00:00.000Z\",\n  \"endsAt\": \"2027-01-15T12:00:00.000Z\",\n  \"location\": \"Training Room\",\n  \"meetingUrl\": \"https://example.com/meeting\"\n}",
              "options": {
