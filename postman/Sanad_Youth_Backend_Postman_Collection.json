            "description": "Requires SUPERVISOR or ADMIN token. The logged-in supervisor is assigned to the program.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Example Youth Program\",\n  \"description\": \"Program created for API testing.\",\n  \"capacity\": 20,\n  \"isPublished\": true\n}",
              "options": {
