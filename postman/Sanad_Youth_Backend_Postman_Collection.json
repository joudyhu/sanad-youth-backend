{
  "info": {
    "name": "Sanad Youth Backend API",
    "description": "Postman collection for reviewing and testing the Sanad Youth Backend. Set baseUrl to http://localhost:3000. Register/login returns accessToken, which is saved automatically for protected requests. Some requests require a user with the appropriate role (YOUTH, SUPERVISOR, ADMIN) and existing resource IDs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "programId",
      "value": "REPLACE_WITH_PROGRAM_ID"
    },
    {
      "key": "applicationId",
      "value": "REPLACE_WITH_APPLICATION_ID"
    },
    {
      "key": "announcementId",
      "value": "REPLACE_WITH_ANNOUNCEMENT_ID"
    },
    {
      "key": "materialId",
      "value": "REPLACE_WITH_MATERIAL_ID"
    }
  ],
  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Register Youth",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates a YOUTH account. Use a new email address each time.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Youth\",\n  \"email\": \"youth@example.com\",\n  \"password\": \"ChangeMe123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.accessToken) pm.collectionVariables.set('token', data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Logs in and stores accessToken in the collection variable token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"youth@example.com\",\n  \"password\": \"ChangeMe123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.accessToken) pm.collectionVariables.set('token', data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
