generator client {
provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
YOUTH
SUPERVISOR
ADMIN
}

enum ApplicationStatus {
PENDING
ACCEPTED
REJECTED
CANCELLED
}

enum AnnouncementScope {
GENERAL
PROGRAM
}


model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role @default(YOUTH)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  programs     Program[] @relation("ProgramSupervisor")
  applications Application[]
  announcements Announcement[] @relation("AnnouncementAuthor")
  @@index([role])
}

model Program {
  id             String @id @default(cuid())
  title          String
  description    String
  imagePath      String?
  capacity       Int
  reservedSeats  Int @default(0)
  isPublished    Boolean @default(false)
  supervisorId   String
  supervisor     User @relation("ProgramSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict)
  sessions       Session[]
  applications   Application[]
  announcements  Announcement[]
  materials      Material[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([isPublished, createdAt])
  @@index([supervisorId])
}

model Session {
  id        String @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  location  String?
  meetingUrl String?
  createdAt DateTime @default(now())
  @@index([programId, startsAt])
}

model Application {
  id          String @id @default(cuid())
  userId      String
  programId   String
  status      ApplicationStatus @default(PENDING)
  cvPath      String?
  reviewedById String?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  @@unique([userId, programId])
  @@index([programId, status])
  @@index([userId, createdAt])
}

model Announcement {
  id        String @id @default(cuid())
  title     String
  body      String
  scope     AnnouncementScope @default(GENERAL)
  programId String?
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program   Program? @relation(fields: [programId], references: [id], onDelete: Cascade)
  author    User @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  @@index([scope, createdAt])
  @@index([programId, createdAt])
}

model Material {
  id        String @id @default(cuid())
  title     String
  filePath  String
  mimeType  String
  size      Int
  programId String
  uploadedById String
  createdAt DateTime @default(now())
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  @@index([programId, createdAt])
}
